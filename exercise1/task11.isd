
% Task 21: Sphere minus three orthogonal cylinders
numeric_gradient[epsilon=0.0625;numeric=false](
    difference(
        sphere,
        union(
            % Z-axis cylinder
            scale[sx=0.6;sy=0.6](cylinder),
            
            % X-axis cylinder (rotated 90 degrees around Y-axis)
            rotate[a=90.0;nx=0.0;ny=1.0;nz=0.0](
                scale[sx=0.6;sy=0.6](cylinder)
            ),
            
            % Y-axis cylinder (rotated 90 degrees around X-axis)
            rotate[a=90.0;nx=1.0;ny=0.0;nz=0.0](
                scale[sx=0.6;sy=0.6](cylinder)
            )
        )
    )
)