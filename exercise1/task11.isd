% Task 1.1c
numeric_gradient[epsilon=0.0625;numeric=false](
    difference(
        sphere[radius=1.0],
        union(
            % Z-axis cylinder
            cylinder[radius=0.6;direction_x=0.0;direction_y=0.0;direction_z=1.0],
            
            % X-axis cylinder
            cylinder[radius=0.6;direction_x=1.0;direction_y=0.0;direction_z=0.0],
            
            % Y-axis cylinder
            cylinder[radius=0.6;direction_x=0.0;direction_y=1.0;direction_z=0.0]
        )
    )
)